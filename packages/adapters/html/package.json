{
  "name": "html-to-document-adapter-html",
  "version": "0.2.0",
  "description": "HTML adapter for html-to-document-core — serializes a DocumentElement tree back into HTML output.",
  "keywords": [
    "html-to-document",
    "html",
    "adapter",
    "serializer"
  ],
  "license": "ISC",
  "homepage": "https://github.com/ChipiKaf/html-to-document#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChipiKaf/html-to-document.git",
    "directory": "packages/adapters/html"
  },
  "bugs": {
    "url": "https://github.com/ChipiKaf/html-to-document/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js"
      }
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest --watch false",
    "test:watch": "vitest --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.d.ts'",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'"
  },
  "dependencies": {
    "html-to-document-core": "workspace:*"
  },
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
